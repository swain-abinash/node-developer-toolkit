{
  "name": "@abinashswain/node-developer-toolkit",
  "version": "1.1.0-next.0",
  "description": "Production-grade utility toolkit for Node.js and Express applications providing standardized API responses, error handling, structured logging, async handlers, pagination, and validation.",
  "keywords": [
    "nodejs",
    "express",
    "toolkit",
    "api-response",
    "error-handler",
    "logger",
    "pagination",
    "async-handler",
    "validator",
    "typescript",
    "utilities"
  ],
  "author": "Abinash Swain <swainabinash36@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swain-abinash/node-developer-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/swain-abinash/node-developer-toolkit/issues"
  },
  "homepage": "https://github.com/swain-abinash/node-developer-toolkit#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./logger": {
      "import": {
        "types": "./dist/logger/index.d.ts",
        "default": "./dist/logger/index.js"
      },
      "require": {
        "types": "./dist/logger/index.d.cts",
        "default": "./dist/logger/index.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors/index.d.ts",
        "default": "./dist/errors/index.js"
      },
      "require": {
        "types": "./dist/errors/index.d.cts",
        "default": "./dist/errors/index.cjs"
      }
    },
    "./response": {
      "import": {
        "types": "./dist/response/index.d.ts",
        "default": "./dist/response/index.js"
      },
      "require": {
        "types": "./dist/response/index.d.cts",
        "default": "./dist/response/index.cjs"
      }
    },
    "./async-handler": {
      "import": {
        "types": "./dist/async-handler/index.d.ts",
        "default": "./dist/async-handler/index.js"
      },
      "require": {
        "types": "./dist/async-handler/index.d.cts",
        "default": "./dist/async-handler/index.cjs"
      }
    },
    "./pagination": {
      "import": {
        "types": "./dist/pagination/index.d.ts",
        "default": "./dist/pagination/index.js"
      },
      "require": {
        "types": "./dist/pagination/index.d.cts",
        "default": "./dist/pagination/index.cjs"
      }
    },
    "./validator": {
      "import": {
        "types": "./dist/validator/index.d.ts",
        "default": "./dist/validator/index.js"
      },
      "require": {
        "types": "./dist/validator/index.d.cts",
        "default": "./dist/validator/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.ts",
        "default": "./dist/utils/index.js"
      },
      "require": {
        "types": "./dist/utils/index.d.cts",
        "default": "./dist/utils/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run build",
    "example": "tsx examples/express-server.ts"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^3.0.5",
    "express": "^4.21.2",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
